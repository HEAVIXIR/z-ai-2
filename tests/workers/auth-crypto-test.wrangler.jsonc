{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "heavix-auth-crypto-workerd-test",
  "main": "./auth-crypto-harness.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_CRYPTO",
        "class_name": "HeavixAuthCrypto"
      }
    ]
  },
  "migrations": [
    {
      "tag": "test-v1",
      "new_sqlite_classes": ["HeavixAuthCrypto"]
    }
  ]
}
