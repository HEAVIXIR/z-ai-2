// ════════════════════════════════════════════════════════════
// USERS + AUTH
// ════════════════════════════════════════════════════════════

model User {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  email          String   @unique
  mobile         String   @unique
  passwordHash   String
  userType       String   @default("INDIVIDUAL")
  role           String   @default("BUYER")
  status         String   @default("PENDING")
  emailVerified  Boolean  @default(false)
  mobileVerified Boolean  @default(false)
  companyName    String?
  lastLoginAt    DateTime?
  verificationDeadline DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  listings       Listing[] @relation("UserListings")
  requests       BuyRequest[] @relation("UserRequests")
  savedSearches  SavedSearch[] @relation("UserSavedSearches")
  favorites      Favorite[] @relation("UserFavorites")
  articles       Article[] @relation("UserArticles")
  follows        Follow[] @relation("UserFollows")
  offers         ListingOffer[] @relation("UserOffers")
  notifications  Notification[] @relation("UserNotifications")
  referrals      Referral[] @relation("UserReferrals")
  foundingStatus FoundingSeller? @relation("UserFoundingStatus")
  premium        PremiumSubscription? @relation("UserPremium")
  payments       Payment[] @relation("UserPayments")
  companyId      String?
  company        Company?  @relation("CompanyUsers", fields: [companyId], references: [id], onDelete: SetNull)
  dealRoomsAsBuyer  DealRoom[] @relation("DealRoomBuyer")
  dealRoomsAsSeller DealRoom[] @relation("DealRoomSeller")
  rfqs              RFQ[] @relation("UserRFQs")
  rfqQuotes         RFQQuote[] @relation("UserRFQQuotes")
  auctionBids       AuctionBid[] @relation("UserAuctionBids")
  companyClaims     CompanyClaim[] @relation("UserCompanyClaims")
  sessions       Session[]
  verificationCodes VerificationCode[]
  userRoles      UserRole[]
  recommendations UserRecommendation[] @relation("UserRecommendations")
  conversations1 Conversation[] @relation("ConvParticipant1")
  conversations2 Conversation[] @relation("ConvParticipant2")
  sentMessages   Message[]   @relation("MessageSender")
  avgRating      Float?
  reviewCount    Int      @default(0)
  reviewsReceived Review[] @relation("SellerReviews")
  reviewsWritten  Review[] @relation("ReviewAuthor")
  dealsAsBuyer    Deal[] @relation("DealBuyer")
  dealsAsSeller   Deal[] @relation("DealSeller")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  username  String
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([expiresAt])
}

model VerificationCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String   @default("MOBILE")
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ════════════════════════════════════════════════════════════
// LEGACY
