model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorType   String   @default("USER")
  action      String
  entityType  String
  entityId    String?
  beforeJson  String?
  afterJson   String?
  ip          String?
  userAgent   String?
  requestId   String?
  reason      String?
  createdAt   DateTime @default(now())
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════
// RBAC (Role / Permission / RolePermission / UserRole)
// ════════════════════════════════════════════════════════════

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  nameFa      String
  nameEn      String?
  description String?
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime @default(now())
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  nameFa      String
  nameEn      String?
  description String?
  resource    String
  roles       RolePermission[]
  createdAt   DateTime @default(now())
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  role         Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@unique([roleId, permissionId])
}

model UserRole {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([userId, roleId])
}

// ════════════════════════════════════════════════════════════
// CATALOG ENTITIES (Product / Machine / Part / Attachment)
// ════════════════════════════════════════════════════════════

model Product {
  id            String   @id @default(cuid())
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?   @relation(fields: [brandId], references: [id])
  modelId       String?
  model         ProductModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  canonicalName String
  slug          String   @unique
  status        String   @default("ACTIVE")
  description   String?
  source        String?
  confidence    Float?
  verifiedAt    DateTime?
  verifiedBy    String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  listings      Listing[]
  machines      Machine[]
  parts         Part[]
  attachments   Attachment[]
  priceRecords  PriceRecord[]
  @@index([categoryId])
  @@index([brandId])
}

model Machine {
  id            String   @id @default(cuid())
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  listingId     String?
  listing       Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  serialNumber  String?
  manufactureYear Int?
  hours         Int?
  condition     String?
  ownershipHistory String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([productId])
}

model Part {
  id            String   @id @default(cuid())
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  partNumber    String?
  oemNumber     String?
  condition     String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([productId])
}

model Attachment {
  id            String   @id @default(cuid())
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  attachmentType String?
  capacity      String?
  condition     String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([productId])
}

model CompatibilityEdge {
  id              String   @id @default(cuid())
  sourceEntityType String
  sourceEntityId   String
  targetEntityType String
  targetEntityId   String
  relationType     String
  confidence       Float?
  source           String?
  verified         Boolean @default(false)
  verifiedBy       String?
  verifiedAt       DateTime?
  createdAt        DateTime @default(now())
  @@unique([sourceEntityType, sourceEntityId, targetEntityType, targetEntityId, relationType])
  @@index([sourceEntityType, sourceEntityId])
  @@index([targetEntityType, targetEntityId])
}

// ════════════════════════════════════════════════════════════
// PRICE INTELLIGENCE
// ════════════════════════════════════════════════════════════

model PriceRecord {
  id          String   @id @default(cuid())
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId  String?
  brandId     String?
  price       Float
  currency    String   @default("IRR")
  year        Int?
  condition   String?
  recordedAt  DateTime @default(now())
  source      String   @default("LISTING")
  @@index([productId])
  @@index([categoryId, brandId])
  @@index([recordedAt])
}

model SearchQuery {
  id          String   @id @default(cuid())
  query       String
  normalizedQuery String
  resultCount Int      @default(0)
  userId      String?
  ip          String?
  categorySlug String?
  brandSlug   String?
  hasResults  Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@index([normalizedQuery])
  @@index([createdAt])
  @@index([hasResults])
}

// ════════════════════════════════════════════════════════════
// AI AGENTS PLATFORM
// ════════════════════════════════════════════════════════════

model AIAgent {
  id          String   @id @default(cuid())
  key         String   @unique
  nameFa      String
  nameEn      String?
  description String?
  taskType    String
  config      String?
  active      Boolean  @default(true)
  lastRunAt   DateTime?
  lastStatus  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════
// OPPORTUNITY ENGINE
// ════════════════════════════════════════════════════════════

model Opportunity {
  id          String   @id @default(cuid())
  type        String
  entityType  String
  entityId    String?
  title       String
  description String?
  score       Float
  metadata    String?
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  @@index([type, status])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════
// ADVANCED SEO AUTOMATION
// ════════════════════════════════════════════════════════════

model SEOMetadata {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  metaTitle     String?
  metaDescription String?
  keywords      String?
  canonicalUrl  String?
  ogImage       String?
  ogTitle       String?
  ogDescription String?
  structuredData String?
  robotsIndex   Boolean  @default(true)
  robotsFollow  Boolean  @default(true)
  sitemapPriority Float @default(0.5)
  sitemapChangeFreq String @default("weekly")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([entityType, entityId])
  @@index([entityType])
}

// ════════════════════════════════════════════════════════════
// RECOMMENDATION ENGINE
// ════════════════════════════════════════════════════════════

model UserRecommendation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserRecommendations", fields: [userId], references: [id], onDelete: Cascade)
  listingId   String
  listing     Listing   @relation("ListingRecommendations", fields: [listingId], references: [id], onDelete: Cascade)
  reason      String
  score       Float     @default(0)
  dismissed   Boolean   @default(false)
  clickedAt   DateTime?
  createdAt   DateTime  @default(now())
  @@unique([userId, listingId, reason])
  @@index([userId, createdAt])
  @@index([userId, dismissed])
}

// ════════════════════════════════════════════════════════════
// SITE STATS
// ════════════════════════════════════════════════════════════

model SiteStat {
  id          String   @id @default(cuid())
  key         String   @unique
  labelFa     String
  labelEn     String?
  metric      String
  customValue String?
  icon        String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════
// SELL IN 7 DAYS
// ════════════════════════════════════════════════════════════

model SellIn7DaysApplication {
  id               String   @id @default(cuid())
  trackingCode     String   @unique
  sellerName       String
  sellerMobile     String
  sellerEmail      String?
  deviceName       String
  categoryId       String?
  brandId          String?
  modelName        String?
  year             Int?
  workingHours     Int?
  condition        String?
  province         String?
  city             String?
  expectedPrice    BigInt?
  description      String?
  prepaymentPaid   Boolean  @default(false)
  prepaymentAmount BigInt?
  status           String   @default("PENDING_PREPAYMENT")
  currentStep      Int      @default(1)
  inspectionDate   DateTime?
  valuationPrice   BigInt?
  salePrice        BigInt?
  commissionAmount BigInt?
  soldAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([status])
  @@index([sellerMobile])
}

// ════════════════════════════════════════════════════════════
// PRICE ESTIMATION ENGINE
// ════════════════════════════════════════════════════════════

model PriceObservation {
  id              String   @id @default(cuid())
  listingId       String?
  listing         Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  productId       String?
  brandId         String?
  brand           Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  modelId         String?
  askingPrice     BigInt?
  estimatedPrice  Float?
  priceLower      Float?
  priceUpper      Float?
  currency        String   @default("IRR")
  normalizedPrice Float?
  source          String   @default("LISTING")
  sourceType      String?
  observedAt      DateTime @default(now())
  market          String?
  quality         String   @default("MEDIUM")
  status          String   @default("ACTIVE")
  confidence      String?
  comparableCount Int?
  notes           String?
  createdAt       DateTime @default(now())
  @@index([brandId, categoryId])
  @@index([modelId])
  @@index([observedAt])
}

model PriceEstimate {
  id              String   @id @default(cuid())
  listingId       String?
  listing         Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  estimatedPrice  Float
  priceLower      Float
  priceUpper      Float
  confidence      String   @default("MEDIUM")
  comparableCount Int      @default(0)
  dataFreshness   String?
  mainDrivers     String?
  warnings        String?
  modelVersion    String   @default("v1.0")
  createdAt       DateTime @default(now())
  @@index([listingId])
}

model PriceOverride {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  originalEstimate Float
  overridePrice    Float
  reason      String
  overriddenBy String?
  overriddenAt DateTime @default(now())
  @@index([listingId])
}

// ════════════════════════════════════════════════════════════
// MACHINE COMPARISON ENGINE
// ════════════════════════════════════════════════════════════

model ComparisonSession {
  id              String   @id @default(cuid())
  userId          String?
  name            String?
  shareToken      String?  @unique
  shareExpiresAt  DateTime?
  status          String   @default("ACTIVE")
  aiSummary       String?
  aiSummaryAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           ComparisonItem[]
}

model ComparisonItem {
  id          String   @id @default(cuid())
  sessionId   String
  session     ComparisonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  productId   String?
  brandId     String?
  modelId     String?
  sortOrder   Int      @default(0)
  @@index([sessionId])
}

// ════════════════════════════════════════════════════════════
// DIRECT MESSAGING
// ════════════════════════════════════════════════════════════

model Conversation {
  id               String    @id @default(cuid())
  listingId        String?
  listing          Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  participant1Id   String
  participant1     User      @relation("ConvParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2Id   String
  participant2     User      @relation("ConvParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  lastMessageAt    DateTime?
  lastMessagePreview String?
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  messages         Message[]
  @@unique([participant1Id, participant2Id, listingId])
  @@index([participant1Id])
  @@index([participant2Id])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  attachmentUrl  String?
  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════
// ANALYTICS + MODERATION
// ════════════════════════════════════════════════════════════

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String
  userId      String?
  listingId   String?
  categoryId  String?
  brandId     String?
  query       String?
  page        String?
  referrer    String?
  ip          String?
  userAgent   String?
  metadata    String?
  createdAt   DateTime @default(now())
  @@index([eventType])
  @@index([userId])
  @@index([listingId])
  @@index([createdAt])
}

model ModerationLog {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  action      String
  reason      String?
  riskScore   Float?
  flaggedIssues String?
  moderatorId String?
  createdAt   DateTime @default(now())
  @@index([listingId])
  @@index([action])
}

// ════════════════════════════════════════════════════════════
// PAYMENT + LEDGER
// ════════════════════════════════════════════════════════════

model Payment {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  orderId         String?
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount          BigInt
  currency        String    @default("IRR")
  type            String
  status          String    @default("PENDING")
  gateway         String?
  providerReference String?
  trackingCode    String?
  idempotencyKey  String?   @unique
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([userId])
  @@index([status])
  @@index([orderId])
}

// ════════════════════════════════════════════════════════════
// REVIEWS + RATINGS
// ════════════════════════════════════════════════════════════

model Review {
  id              String   @id @default(cuid())
  authorId        String
  author          User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sellerId        String?
  seller          User?    @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  dealRoomId      String?  @unique
  dealRoom        DealRoom? @relation(fields: [dealRoomId], references: [id], onDelete: SetNull)
  dealId          String?  @unique
  deal            Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  orderId         String?
  listingId       String?
  listing         Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  rating          Int
  title           String?
  body            String
  verifiedDeal    Boolean  @default(false)
  sellerResponse   String?
  sellerRespondedAt DateTime?
  status          String   @default("PENDING")
  adminNotes      String?
  moderatedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([companyId, status])
  @@index([sellerId, status])
  @@index([status])
}

// ════════════════════════════════════════════════════════════
// ORDERS / DEALS / TRANSACTIONS (Phase 9)
// ════════════════════════════════════════════════════════════

model Deal {
  id              String    @id @default(cuid())
  dealNumber      String    @unique
  sourceType      String
  sourceId        String
  buyerId         String?
  buyer           User?     @relation("DealBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  sellerId        String?
  seller          User?     @relation("DealSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  listingId       String?
  listing         Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  agreedAmount    BigInt?
  currency        String    @default("IRR")
  transactionType String    @default("SALE")
  status          String    @default("DRAFT")
  agreedAt        DateTime?
  confirmedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  order           Order?
  disputes        Dispute[]
  review          Review?
  @@index([buyerId])
  @@index([sellerId])
  @@index([listingId])
  @@index([status])
}

model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique
  dealId          String    @unique
  deal            Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  titleSnapshot   String
  priceSnapshot   BigInt
  currencySnapshot String   @default("IRR")
  sellerSnapshot  String?
  buyerSnapshot   String?
  quantity        Int       @default(1)
  status          String    @default("PENDING")
  commissionRate  Float?
  commissionAmount BigInt?
  sellerAmount    BigInt?
  confirmedAt     DateTime?
  fulfilledAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  payments        Payment[]
  disputes        Dispute[]
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([status])
}

model Dispute {
  id              String    @id @default(cuid())
  dealId          String?
  deal            Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          String    @default("OPEN")
  reason          String
  description     String?
  evidence        String?
  openedBy        String
  openedAt        DateTime  @default(now())
  resolution      String?
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([dealId])
  @@index([orderId])
  @@index([status])
}
