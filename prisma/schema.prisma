  updatedAt   DateTime @updatedAt
  @@index([listingId])
}

model RejectionMessage {
  id          String   @id @default(cuid())
  rejectionId String
  rejection   ListingRejection @relation(fields: [rejectionId], references: [id], onDelete: Cascade)
  senderRole  String
  senderName  String?
  message     String
  createdAt   DateTime @default(now())
}

// ════════════════════════════════════════════════════════════
// NOTIFICATION ENGINE
// ════════════════════════════════════════════════════════════

model Notification {
