// HEAVIX — Industrial heavy-machinery marketplace
// PostgreSQL production schema (migrated from SQLite per ADR-001)
// 113 models total — received from user across 5 parts (2026-09-23)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════
// BRAND CATALOG OS
// ════════════════════════════════════════════════════════════

model Brand {
  id          String    @id @default(cuid())
  name        String
  nameEn      String?
  shortName   String?
  slug        String    @unique
  logoUrl     String?
  website     String?
  country     String?
  description String?
  featured    Boolean   @default(false)
  active      Boolean   @default(true)
  status      String    @default("ACTIVE")
  type        String?
  verification String   @default("UNVERIFIED")
  parentBrandId String?
  parentBrand   Brand?    @relation("BrandParent", fields: [parentBrandId], references: [id], onDelete: SetNull)
  childBrands   Brand[]   @relation("BrandParent")
  brandFamilyId String?
  brandFamily   BrandFamily? @relation(fields: [brandFamilyId], references: [id], onDelete: SetNull)
  priceObservations PriceObservation[]
  manufacturer  String?
  foundedYear   Int?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  categories  BrandCategory[]
  domains     BrandDomain[]
  media       BrandMedia[]
  seo         BrandSEO?
  display     BrandDisplay?
  models      ProductModel[]
  products    Product[]
  listings    Listing[]
  aliases     BrandAlias[]
  industries  BrandIndustry[]
}

model BrandAlias {
  id              String  @id @default(cuid())
  brandId         String
  brand           Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  value           String
  normalizedValue String
  language        String  @default("fa")
  type            String  @default("COMMON")
  confidence      Int     @default(80)
  createdAt       DateTime @default(now())
  @@unique([brandId, normalizedValue])
  @@index([normalizedValue])
}

model BrandFamily {
  id          String  @id @default(cuid())
  name        String
  nameEn      String?
  slug        String  @unique
  description String?
  logoUrl     String?
  website     String?
  country     String?
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  brands      Brand[]
}

model BrandIndustry {
  id        String  @id @default(cuid())
  brandId   String
  brand     Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  industry  String
  @@unique([brandId, industry])
  @@index([industry])
}

model Industry {
  id        String  @id @default(cuid())
  key       String  @unique
  nameFa    String
  nameEn    String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  createdAt DateTime @default(now())
}

model BrandCategory {
  id        String  @id @default(cuid())
  brandId   String
  brand     Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categoryId String
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@unique([brandId, categoryId])
}

model BrandDomain {
  id        String  @id @default(cuid())
  brandId   String
  brand     Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  domain    String
  @@unique([brandId, domain])
}

model BrandMedia {
  id        String  @id @default(cuid())
  brandId   String
  brand     Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  type      String
  url       String
  title     String?
  sortOrder Int     @default(0)
}

model BrandSEO {
  id             String  @id @default(cuid())
  brandId        String  @unique
  brand          Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  metaTitle      String?
  metaDescription String?
  keywords       String?
  ogImage        String?
}

model BrandDisplay {
  id              String  @id @default(cuid())
  brandId         String  @unique
  brand           Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  showOnHomepage  Boolean @default(true)
  showInFooter    Boolean @default(false)
  accentColor     String?
  displayOrder    Int     @default(0)
}

// ════════════════════════════════════════════════════════════
// TAXONOMY — Category tree + Dynamic Attributes
// ════════════════════════════════════════════════════════════

model Category {
  id          String     @id @default(cuid())
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  name        String
  nameEn      String?
  slug        String     @unique
  icon        String?
  imageUrl    String?
  description String?
  domain      String?
  layer       String     @default("CATALOG")
  taxPath     String?
  featured    Boolean    @default(false)
  active      Boolean    @default(true)
  showOnHome  Boolean    @default(true)
  sortOrder   Int        @default(0)
  level       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  listings    Listing[]
  attributes  CategoryAttribute[]
  brands      BrandCategory[]
  modelCategories ModelCategory[]
  models      ProductModel[]
  products    Product[]
  appIndustries CategoryApplicationIndustry[]
  priceObservations PriceObservation[]
}

model TransactionType {
  id          String   @id @default(cuid())
  key         String   @unique
  nameFa      String
  nameEn      String?
  description String?
  icon        String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  listings    Listing[]
}

model ServiceType {
  id          String   @id @default(cuid())
  key         String   @unique
  nameFa      String
  nameEn      String?
  description String?
  icon        String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Service {
  id          String   @id @default(cuid())
  key         String   @unique
  nameFa      String
  nameEn      String?
  description String?
  icon        String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomeCategoryConfig {
  id                  String   @id @default("main")
  homeCategoryGeneration Int   @default(1)
  homeCategoryParentId String?
  updatedAt           DateTime @updatedAt
}

model ApplicationIndustry {
  id        String  @id @default(cuid())
  key       String  @unique
  nameFa    String
  nameEn    String?
  icon      String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  categories CategoryApplicationIndustry[]
}

model CategoryApplicationIndustry {
  id        String  @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  applicationIndustryId String
  applicationIndustry   ApplicationIndustry @relation(fields: [applicationIndustryId], references: [id], onDelete: Cascade)
  @@unique([categoryId, applicationIndustryId])
}

// ════════════════════════════════════════════════════════════
// LOCATION
// ════════════════════════════════════════════════════════════

model Country {
  id        String  @id @default(cuid())
  name      String  @unique
  nameEn    String?
  code      String? @unique
  phoneCode String?
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  provinces Province[]
  listings  Listing[]
}

model Province {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name      String
  nameEn    String?
  code      String?
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  cities    City[]
  listings  Listing[] @relation("ListingProvince")
  @@unique([countryId, name])
}

model City {
  id         String  @id @default(cuid())
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name       String
  nameEn     String?
  latitude   Float?
  longitude  Float?
  sortOrder  Int     @default(0)
  createdAt  DateTime @default(now())
  listings   Listing[] @relation("ListingCity")
  branches   CompanyBranch[]
  @@unique([provinceId, name])
}

// ════════════════════════════════════════════════════════════
// DYNAMIC ATTRIBUTES
// ════════════════════════════════════════════════════════════

model AttributeDefinition {
  id          String   @id @default(cuid())
  key         String?  @unique
  name        String
  nameEn      String?
  labelFa     String?
  labelEn     String?
  type        String
  unit        String?
  required    Boolean  @default(false)
  filterable  Boolean  @default(false)
  searchable  Boolean  @default(false)
  sortable    Boolean  @default(false)
  visibleOnCard   Boolean @default(false)
  visibleOnDetail Boolean @default(true)
  seoRelevant Boolean  @default(false)
  aiRelevant  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  options     AttributeOption[]
  categories  CategoryAttribute[]
  values      ListingAttributeValue[]
}

model AttributeOption {
  id          String   @id @default(cuid())
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  label       String?
  sortOrder   Int      @default(0)
}

model CategoryAttribute {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  required    Boolean  @default(false)
  filterable  Boolean  @default(false)
  searchable  Boolean  @default(false)
  sortable    Boolean  @default(false)
  displayOrder Int     @default(0)
  @@unique([categoryId, attributeId])
}

model ListingAttributeValue {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  textValue    String?
  numberValue  Float?
  booleanValue Boolean?
  dateValue    DateTime?
  optionId     String?
  unit         String?
  sourceType   String?
  confidence   Float?
  sourceReference String?
  verifiedAt   DateTime?
  verifiedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([listingId, attributeId])
  @@index([attributeId])
}

// ════════════════════════════════════════════════════════════
// PRODUCT MODELS + GENERATIONS
// ════════════════════════════════════════════════════════════

model ProductModel {
  id            String         @id @default(cuid())
  brandId       String
  brand         Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name          String
  nameEn        String?
  slug          String
  description   String?
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status        String         @default("ACTIVE")
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  modelCategories ModelCategory[]
  generations   Generation[]
  listings      Listing[]
  products      Product[]
  @@unique([brandId, slug])
}

model ModelCategory {
  id        String  @id @default(cuid())
  modelId   String
  model     ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  categoryId String
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@unique([modelId, categoryId])
}

model Generation {
  id          String       @id @default(cuid())
  modelId     String
  model       ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  name        String
  nameEn      String?
  slug        String
  description String?
  yearFrom    Int?
  yearTo      Int?
  status      String       @default("ACTIVE")
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@unique([modelId, slug])
}

// ════════════════════════════════════════════════════════════
// LISTINGS
// ════════════════════════════════════════════════════════════

model Listing {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  description  String?
  shortDesc    String?
  price        BigInt?
  priceType    String         @default("NEGOTIABLE")
  listingType  String         @default("SALE")
  condition    String?
  province     String?
  city         String?
  year         Int?
  workingHours Int?
  status       String         @default("PUBLISHED")
  featured     Boolean        @default(false)
  verified     Boolean        @default(false)
  showInLatest Boolean        @default(true)
  viewCount    Int            @default(0)
  favoriteCount Int           @default(0)
  publishedAt  DateTime?
  expiresAt    DateTime?
  soldAt       DateTime?
  sellerPhone  String?
  sellerName   String?
  sourceUrl    String?
  sourceSite   String?
  adminNotes   String?
  rentalPeriod          String?
  deposit               BigInt?
  minimumRentalPeriod   Int?
  operatorIncluded      Boolean   @default(false)
  fuelIncluded          Boolean   @default(false)
  transportIncluded     Boolean   @default(false)
  availabilityStart     DateTime?
  availabilityEnd       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  brandId      String?
  brand        Brand?         @relation(fields: [brandId], references: [id])
  categoryId   String?
  category     Category?      @relation(fields: [categoryId], references: [id])
  modelId      String?
  model        ProductModel?  @relation(fields: [modelId], references: [id], onDelete: SetNull)
  sellerId     String?
  seller       User?          @relation("UserListings", fields: [sellerId], references: [id], onDelete: SetNull)
  companyId    String?
  company      Company?       @relation("CompanyListings", fields: [companyId], references: [id], onDelete: SetNull)
  productId        String?
  product          Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  transactionTypeId String?
  transactionType   TransactionType? @relation(fields: [transactionTypeId], references: [id], onDelete: SetNull)
  countryId      String?
  country        Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  provinceId     String?
  provinceRel    Province? @relation("ListingProvince", fields: [provinceId], references: [id], onDelete: SetNull)
  cityId         String?
  cityRel        City?     @relation("ListingCity", fields: [cityId], references: [id], onDelete: SetNull)
  images       ListingImage[]
  favorites    Favorite[]
  leads        Lead[]
  offers       ListingOffer[]
  rejections   ListingRejection[]
  dealRooms    DealRoom[]
  inspections  Inspection[]
  transportRequests TransportRequest[]
  auctions     Auction[]
  passport     MachinePassport?
  attributeValues ListingAttributeValue[]
  socialReels   SocialReel[]
  machines     Machine[]
  priceRecords PriceRecord[]
  priceObservations PriceObservation[]
  priceEstimates    PriceEstimate[]
  priceOverrides    PriceOverride[]
  recommendations UserRecommendation[] @relation("ListingRecommendations")
  comparisonItems ComparisonItem[]
  conversations Conversation[]
  moderationLogs ModerationLog[]
  reviews        Review[]
  deals          Deal[]
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

// ════════════════════════════════════════════════════════════
// BUY REQUESTS (HEAVIX Wanted)
// ════════════════════════════════════════════════════════════

model BuyRequest {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  brandPref   String?
  transaction String   @default("SALE")
  budgetMin   BigInt?
  budgetMax   BigInt?
  city        String?
  province    String?
  deadline    String?
  status      String   @default("ACTIVE")
  verified    Boolean  @default(false)
  viewCount   Int      @default(0)
  requesterName  String?
  requesterPhone String?
  adminNotes  String?
  publishedAt DateTime? @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String?
  user        User?     @relation("UserRequests", fields: [userId], references: [id], onDelete: SetNull)
}

// ════════════════════════════════════════════════════════════
// SAVED SEARCH + ALERTS
// ════════════════════════════════════════════════════════════

model SavedSearch {
  id          String   @id @default(cuid())
  name        String
  query       String?
  categorySlug String?
  brandSlug   String?
  minPrice    BigInt?
  maxPrice    BigInt?
  condition   String?
  city        String?
  notifyEmail Boolean  @default(true)
  notifyPush  Boolean  @default(false)
  lastNotifiedAt DateTime?
  matchCount  Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation("UserSavedSearches", fields: [userId], references: [id], onDelete: SetNull)
}

// ════════════════════════════════════════════════════════════
// WISHLIST / FAVORITES
// ════════════════════════════════════════════════════════════

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation("UserFavorites", fields: [userId], references: [id], onDelete: SetNull)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@unique([userId, listingId])
}

// ════════════════════════════════════════════════════════════
// LEADS
// ════════════════════════════════════════════════════════════

model Lead {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  leadType    String
  viewerPhone String?
  viewerName  String?
  note        String?
  createdAt   DateTime @default(now())
}

// ════════════════════════════════════════════════════════════
// KNOWLEDGE / ARTICLES
// ════════════════════════════════════════════════════════════

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String
  category    String   @default("GUIDE")
  tags        String?
  coverImage  String?
  status      String   @default("PUBLISHED")
  viewCount   Int      @default(0)
  publishedAt DateTime? @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorId    String?
  author      User?    @relation("UserArticles", fields: [authorId], references: [id], onDelete: SetNull)
}

// ════════════════════════════════════════════════════════════
// FOLLOW BRAND / CATEGORY
// ════════════════════════════════════════════════════════════

model Follow {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserFollows", fields: [userId], references: [id], onDelete: Cascade)
  followType  String
  targetId    String
  createdAt   DateTime @default(now())
  @@unique([userId, followType, targetId])
}

// ════════════════════════════════════════════════════════════
// HOT SEARCH
// ════════════════════════════════════════════════════════════

model HotSearch {
  id        String   @id @default(cuid())
  term      String
  link      String?
  count     Int      @default(0)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ════════════════════════════════════════════════════════════
// SITE WIDGETS
// ════════════════════════════════════════════════════════════

model SiteWidget {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  content   String
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════
// AI KNOWLEDGE BASE
// ════════════════════════════════════════════════════════════

model KnowledgeEntry {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  title         String
  key           String
  value         String
  unit          String?
  source        String   @default("HEAVIX")
  sourceUrl     String?
  sourceRef     String?
  verified      Boolean  @default(false)
  verifiedBy    String?
  verifiedAt    DateTime?
  aiSuggested   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([entityType, entityId, key])
}

// ════════════════════════════════════════════════════════════
// AI GATEWAY LOG
// ════════════════════════════════════════════════════════════

model AIGatewayLog {
  id          String   @id @default(cuid())
  taskType    String
  model       String
  input       String?
  output      String?
  latencyMs   Int?
  tokensUsed  Int?
  cost        Float?
  success     Boolean  @default(true)
  error       String?
  userId      String?
  createdAt   DateTime @default(now())
  @@index([taskType])
  @@index([userId, taskType, createdAt])
}

// ════════════════════════════════════════════════════════════
// AI BUDGET (singleton)
// ════════════════════════════════════════════════════════════

model AIBudget {
  id              String    @id @default("main")
  dailyLimitUsd   Float     @default(10.0)
  monthlyLimitUsd Float     @default(200.0)
  dailySpendUsd   Float     @default(0.0)
  monthlySpendUsd Float     @default(0.0)
  dailyResetAt    DateTime?
  monthlyResetAt  DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ════════════════════════════════════════════════════════════
// AI TASK POLICY
// ════════════════════════════════════════════════════════════

model AITaskPolicy {
  id              String   @id @default(cuid())
  taskType        String   @unique
  allowedRoles    String
  hourlyLimit     Int      @default(30)
  dailyLimit      Int      @default(100)
  maxInputChars   Int      @default(5000)
  maxOutputTokens Int      @default(2000)
  model           String   @default("default")
  timeoutMs       Int      @default(30000)
  costCeilingUsd  Float    @default(0.05)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════
// LAUNCH PHASE TRACKER
// ════════════════════════════════════════════════════════════

model LaunchPhase {
  id          String   @id @default(cuid())
  phase       Int      @unique
  title       String
  description String?
  targetValue Int
  currentValue Int     @default(0)
  status      String   @default("PENDING")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════
// DEMAND SIGNAL
// ════════════════════════════════════════════════════════════

model DemandSignal {
  id          String   @id @default(cuid())
  query       String
  category    String?
  brand       String?
  city        String?
  resultCount Int      @default(0)
  intent      String?
  convertedToRequest Boolean @default(false)
  createdAt   DateTime @default(now())
  @@index([query])
}

// ════════════════════════════════════════════════════════════
// RFQ — Request For Quote
// ════════════════════════════════════════════════════════════

model RFQ {
  id          String   @id @default(cuid())
  title       String
  description String?
  machineType String?
  brandPref   String?
  quantity    Int      @default(1)
  specJson    String?
  budgetMin   BigInt?
  budgetMax   BigInt?
  location    String?
  deadline    DateTime?
  terms       String?
  status      String   @default("OPEN")
  buyerName   String?
  buyerPhone  String
  buyerEmail  String?
  buyerId     String?
  buyer       User?    @relation("UserRFQs", fields: [buyerId], references: [id], onDelete: SetNull)
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quotes      RFQQuote[]
  @@index([status])
}

model RFQQuote {
  id          String   @id @default(cuid())
  rfqId       String
  rfq         RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sellerName  String
  sellerPhone String
  sellerEmail String?
  sellerId    String?
  seller      User?    @relation("UserRFQQuotes", fields: [sellerId], references: [id], onDelete: SetNull)
  unitPrice   BigInt
  totalPrice  BigInt
  deliveryTime String?
  notes       String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  @@index([rfqId])
}

// ════════════════════════════════════════════════════════════
// AUCTION ENGINE
// ════════════════════════════════════════════════════════════

model Auction {
  id            String    @id @default(cuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  startPrice    BigInt
  reservePrice  BigInt?
  minIncrement  BigInt
  startDate     DateTime
  endDate       DateTime
  status        String    @default("SCHEDULED")
  winnerId      String?
  winnerName    String?
  winningBid    BigInt?
  inspectionReport String?
  adminNotes    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bids          AuctionBid[]
  @@index([status])
}

model AuctionBid {
  id          String   @id @default(cuid())
  auctionId   String
  auction     Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderName  String
  bidderPhone String
  bidderId    String?
  bidder      User?    @relation("UserAuctionBids", fields: [bidderId], references: [id], onDelete: SetNull)
  amount      BigInt
  isWinning   Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@index([auctionId])
}

// ════════════════════════════════════════════════════════════
// INDUSTRIAL PERSIAN DICTIONARY
// ════════════════════════════════════════════════════════════

model IndustrialTerm {
  id          String   @id @default(cuid())
  canonical   String
  entityType  String?
  entityId    String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  aliases     TermAlias[]
}

model TermAlias {
  id          String   @id @default(cuid())
  termId      String
  term        IndustrialTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  alias       String
  aliasType   String   @default("SYNONYM")
  @@unique([termId, alias])
}

// ════════════════════════════════════════════════════════════
// FEATURE FLAGS
// ════════════════════════════════════════════════════════════

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  enabled     Boolean  @default(true)
  rolloutPct  Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════
// COMPANY CLAIM
// ════════════════════════════════════════════════════════════

model CompanyClaim {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation("UserCompanyClaims", fields: [userId], references: [id], onDelete: SetNull)
  claimantName String
  claimantPhone String
  claimantEmail String?
  claimantRole String?
  evidence    String?
  status      String   @default("PENDING")
