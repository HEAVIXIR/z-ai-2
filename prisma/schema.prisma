  type      String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())
  @@index([userId])
}

// ════════════════════════════════════════════════════════════
// REFERRAL PROGRAM
// ════════════════════════════════════════════════════════════

model Referral {
  id          String   @id @default(cuid())
