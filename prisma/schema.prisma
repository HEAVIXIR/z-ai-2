  listingId   String   @unique
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  serialNumber String?
  inspectionDate DateTime?
  inspectionResult String?
  events      PassportEvent[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PassportEvent {
  id          String   @id @default(cuid())
  passportId  String
  passport    MachinePassport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  eventType   String
  title       String
  description String?
  date        DateTime
  performedBy String?
  createdAt   DateTime @default(now())
}

// ════════════════════════════════════════════════════════════
// COMPANY PAGES
// ════════════════════════════════════════════════════════════

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  coverImage  String?
  website     String?
  phone       String?
  email       String?
  address     String?
  city        String?
  province    String?
  verified    Boolean  @default(false)
  premium     Boolean  @default(false)
  status      String   @default("ACTIVE")
  metaTitle       String?
  metaDescription String?
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]   @relation("CompanyUsers")
  listings    Listing[] @relation("CompanyListings")
  claims      CompanyClaim[]
  documents     CompanyDocument[]
  branches      CompanyBranch[]
  verifications CompanyVerification[]
  partners       CompanyPartner[] @relation("CompanyPartners")
  partnerOf      CompanyPartner[] @relation("CompanyPartnerOf")
  avgRating      Float?
  reviewCount    Int      @default(0)
  reviews        Review[]
}

// ════════════════════════════════════════════════════════════
// COMPANY NETWORK
// ════════════════════════════════════════════════════════════

model CompanyPartner {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation("CompanyPartners", fields: [companyId], references: [id], onDelete: Cascade)
  partnerId     String
  partner       Company   @relation("CompanyPartnerOf", fields: [partnerId], references: [id], onDelete: Cascade)
  status        String    @default("PENDING")
  requestedAt   DateTime  @default(now())
  acceptedAt    DateTime?
  notes         String?
  @@unique([companyId, partnerId])
  @@index([companyId])
  @@index([partnerId])
  @@index([status])
}

// ════════════════════════════════════════════════════════════
// COMPANY VERIFICATION LIFECYCLE
// ════════════════════════════════════════════════════════════

model CompanyDocument {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        String
  url         String
  status      String   @default("PENDING")
  verifiedBy  String?
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
  @@index([companyId])
}

model CompanyBranch {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  cityId      String?
  city        City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  phone       String?
  isHeadquarters Boolean @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@index([companyId])
}

model CompanyVerification {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING")
  verificationType String @default("BUSINESS")
  submittedAt DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  notes       String?
  evidence    String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedBy   String?
  revokeReason String?
  @@index([companyId])
  @@index([status])
}

// ════════════════════════════════════════════════════════════
// DEAL ROOM
// ════════════════════════════════════════════════════════════

model DealRoom {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId     String?
  buyer       User?    @relation("DealRoomBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  sellerId    String?
  seller      User?    @relation("DealRoomSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  buyerPhone  String
  sellerPhone String?
  status      String   @default("OPEN")
  buyerConfirmed Boolean @default(false)
  sellerConfirmed Boolean @default(false)
  agreedPrice BigInt?
  lastMessageAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    DealMessage[]
  documents   DealDocument[]
  review      Review?
  @@index([listingId])
}

model DealMessage {
  id        String   @id @default(cuid())
  dealRoomId String
  dealRoom  DealRoom @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  senderRole String
  senderName String?
  message   String
  attachmentUrl String?
  createdAt DateTime @default(now())
}

model DealDocument {
  id          String   @id @default(cuid())
  dealRoomId  String
  dealRoom    DealRoom @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  type        String
  url         String
  uploadedBy  String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  @@index([dealRoomId])
}

// ════════════════════════════════════════════════════════════
// INSPECTION
// ════════════════════════════════════════════════════════════

model Inspection {
  id              String   @id @default(cuid())
  listingId       String
  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  dealRoomId      String?
  requestedBy     String
  inspectorId     String?
  status          String   @default("REQUESTED")
  scheduledDate   DateTime?
  completedAt     DateTime?
  checklist       String?
  score           Float?
  reportUrl       String?
  photos          String?
  notes           String?
  price           BigInt?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([listingId])
  @@index([status])
}

// ════════════════════════════════════════════════════════════
// TRANSPORT REQUEST
// ════════════════════════════════════════════════════════════

model TransportRequest {
  id              String   @id @default(cuid())
  listingId       String?
  listing         Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  dealRoomId      String?
  origin          String
  destination     String
  cargoType       String?
  cargoWeight     Float?
  cargoLength     Float?
  cargoWidth      Float?
  cargoHeight     Float?
  vehicleType     String?
  loadingDate     DateTime?
  deliveryDate    DateTime?
  status          String   @default("REQUESTED")
  quotedPrice     BigInt?
  carrierName     String?
  carrierPhone    String?
  trackingCode    String?
  notes           String?
  requestedBy     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([status])
}

