# HEAVIX — Production Caddy gateway configuration
#
# This file is for PRODUCTION deployments. It does NOT include the
# sandbox :81 listener or dynamic port routing.
# For sandbox/local dev, use Caddyfile.sandbox instead.
#
# TLS: Caddy automatically provisions Let's Encrypt certificates when
# auto_https is enabled (default). The domain MUST be set via the
# HEAVIX_DOMAIN environment variable — there is NO default, because
# a production deployment requires a real domain.
#
# SECURITY: No dynamic port routing in production — prevents SSRF.

# HTTP -> HTTPS redirect
:80 {
	redir https://{host}{uri} permanent
}

# HTTPS with automatic TLS certificate provisioning
# The domain is set via HEAVIX_DOMAIN env var (REQUIRED for production).
# Caddy will provision and manage Let's Encrypt certificates automatically.
:443 {
	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}
