{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heavix-preview",
  "main": ".open-next/worker.js",
  // Keep the established preview runtime date pinned. Populate process.env
  // from Worker bindings for the Prisma 6 PPG adapter path.
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "vars": {
    "HEAVIX_ENV": "preview",
    "NODE_ENV": "production",
    "HEAVIX_BACKUP_EXECUTION_ENABLED": "false",
    "B2_BUCKET_NAME": "heavix-dev-assets",
    "B2_MEDIA_PREFIX": "heavix-media/",
    "B2_REGION": "us-east-005",
    "B2_S3_ENDPOINT": "https://s3.us-east-005.backblazeb2.com"
  },
  "wasm_modules": {
    "JPEG_DEC_WASM": "node_modules/@jsquash/jpeg/codec/dec/mozjpeg_dec.wasm",
    "PNG_WASM": "node_modules/@jsquash/png/codec/pkg/squoosh_png_bg.wasm",
    "WEBP_DEC_WASM": "node_modules/@jsquash/webp/codec/dec/webp_dec.wasm",
    "WEBP_ENC_WASM": "node_modules/@jsquash/webp/codec/enc/webp_enc.wasm",
    "RESIZE_WASM": "node_modules/@jsquash/resize/lib/resize/pkg/squoosh_resize_bg.wasm"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false
  },
  "previews": {
    "vars": {
      "HEAVIX_ENV": "preview",
      "NODE_ENV": "production",
      "HEAVIX_BACKUP_EXECUTION_ENABLED": "false"
    }
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "STORE_DATABASE_URL",
      "HEAVIX_APP_PREVIEW_DATABASE_OID",
      "HEAVIX_STORE_PREVIEW_DATABASE_OID",
      "B2_KEY_ID",
      "B2_APPLICATION_KEY"
    ]
  }
}
