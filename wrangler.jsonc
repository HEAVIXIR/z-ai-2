{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heavix-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/uploads/*.meta.json"
    ]
  },
  "observability": {
    "enabled": true
  },
  "previews": {
    "vars": {
      "HEAVIX_ENV": "preview",
      "NODE_ENV": "production"
    },
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true
      }
    }
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "STORE_DATABASE_URL"
    ]
  }
}
