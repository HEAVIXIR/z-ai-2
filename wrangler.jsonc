{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heavix-preview",
  "main": "scripts/preview-gated-worker.mjs",
  // Keep the established preview runtime date pinned. Populate process.env
  // from Worker bindings for the Prisma 6 PPG adapter path.
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "previews": {
    "vars": {
      "HEAVIX_ENV": "preview",
      "NODE_ENV": "production",
      "HEAVIX_BACKUP_EXECUTION_ENABLED": "false"
    },
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true
      }
    }
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "STORE_DATABASE_URL",
      "HEAVIX_APP_PREVIEW_DATABASE_OID",
      "HEAVIX_STORE_PREVIEW_DATABASE_OID",
      "HEAVIX_PREVIEW_GATE_PASSWORD",
      "HEAVIX_PREVIEW_GATE_SIGNING_KEY"
    ]
  }
}
