{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heavix-preview",
  "main": ".open-next/worker.js",
  // Keep the established preview runtime date pinned. Populate process.env
  // from Worker bindings for the Prisma 6 PPG adapter path.
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false
  },
  "previews": {
    "vars": {
      "HEAVIX_ENV": "preview",
      "NODE_ENV": "production"
    }
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "STORE_DATABASE_URL"
    ]
  }
}
