# HEAVIX - Database Configuration
# PostgreSQL 17 (user-space install, no sudo)
DATABASE_URL=postgresql://heavix@localhost:5432/heavix?schema=public

# PostgreSQL server paths (user-space install at /home/z/pg)
PG_BIN=/home/z/pg/usr/lib/postgresql/17/bin
PGDATA=/home/z/pgdata
PGHOST=/home/z/pgdata/socket
PGUSER=heavix
PGDATABASE=heavix

# Original SQLite source (kept for migration reference)
SQLITE_SOURCE_URL=file:/home/z/my-project/db/heavix-source.db
