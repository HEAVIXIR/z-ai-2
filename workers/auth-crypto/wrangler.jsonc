{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "heavix-auth-crypto-preview",
  "main": "./index.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_CRYPTO",
        "class_name": "HeavixAuthCrypto"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HeavixAuthCrypto"]
    }
  ]
}
