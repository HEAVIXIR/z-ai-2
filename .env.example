# HEAVIX — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env with real values.

# === Database (REQUIRED) ===
# Main marketplace database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/heavix?schema=public"

# Store/parts database (PostgreSQL, separate instance)
STORE_DATABASE_URL="postgresql://user:password@localhost:5433/heavix_store?schema=public"

# === Admin (REQUIRED) ===
# Admin panel login credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-in-production"

# === ZAI Provider Configuration (server-side, runtime-safe) ===
# HEAVIX uses z-ai-web-dev-sdk as its default AI provider. The SDK
# ships with a filesystem-based config loader (.z-ai-config), but
# Cloudflare Workers / OpenNext do not expose a filesystem at
# runtime. HEAVIX's src/lib/ai-provider.ts adapter bypasses the
# filesystem loader and constructs the SDK client directly from
# these env vars. Set them on Cloudflare as `wrangler secret put`
# (or as encrypted Worker secrets in the dashboard); on Vercel as
# Project Settings → Environment Variables.
#
# Required for AI features to work in any runtime:
ZAI_BASE_URL="https://<free-zai-endpoint>/v1"
ZAI_API_KEY="<your-free-api-key>"
# Optional headers forwarded to the provider:
# ZAI_CHAT_ID=""
# ZAI_USER_ID=""
# ZAI_TOKEN=""
#
# NEVER prefix these with NEXT_PUBLIC_ — they must not be exposed
# to the client bundle. The adapter is server-only.
# baseUrl MUST end with /v1 (the SDK appends /chat/completions).
# Never use a paid endpoint/provider for HEAVIX without explicit
# authorization.

# === Legacy .z-ai-config (deprecated for runtime use) ===
# The original z-ai-web-dev-sdk entry point (ZAI.create()) reads
# .z-ai-config from disk. This is still supported for local dev
# only and is .gitignored. Production / Preview MUST use the env
# vars above. See .z-ai-config.example for the file format.

# === Session (OPTIONAL) ===
# Session secret for cookie signing (if different from default)
# SESSION_SECRET="your-session-secret"

# === Site URL (REQUIRED for production, OPTIONAL in local dev) ===
# The canonical public URL of the deployment, without a trailing slash.
# All canonical URLs, sitemap entries, robots.txt Host directive,
# Open Graph URLs, and JSON-LD absolute URLs are derived from this
# value via src/lib/site-config.ts (single source of truth).
#
# Local dev:    unset → falls back to https://heavix.ir (safe default).
# Production:   MUST be set explicitly to the real public URL.
#               A console.warn is emitted at boot if unset in production.
NEXT_PUBLIC_SITE_URL="https://heavix.ir"

# === Deployment (OPTIONAL) ===
# Set NODE_ENV to "production" for production builds
NODE_ENV="development"
