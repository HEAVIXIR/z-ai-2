# HEAVIX — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env with real values.

# === Database (REQUIRED) ===
# Main marketplace database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/heavix?schema=public"

# Store/parts database (PostgreSQL, separate instance)
STORE_DATABASE_URL="postgresql://user:password@localhost:5433/heavix_store?schema=public"

# === Admin (REQUIRED) ===
# Admin panel login credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-in-production"

# === AI Provider Routing (server-side, no automatic fallback) ===
# AI_PROVIDER selects exactly one provider for the central AI Gateway.
# Default: zai. Switching providers requires an explicit environment change.
AI_PROVIDER="zai"
# Marketplace and Store scraper provider calls are disabled unless explicitly enabled.
# Enabling also requires an active SCRAPER DB policy with a positive cost ceiling.
HEAVIX_AI_SCRAPER_ENABLED="false"

# ZAI (default provider) — required by Preview Worker configuration
ZAI_BASE_URL="https://<free-zai-endpoint>/v1"
ZAI_API_KEY="<your-zai-key>"
ZAI_MODEL="glm-4.6-flash"

# Optional OpenAI-compatible providers. Configure only if authorized and funded/free-tier reviewed.
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Gemini's OpenAI-compatible endpoint; no key is bundled or assumed free.
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Anthropic native Messages API adapter.
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# Optional ZAI SDK headers (only used by legacy SDK adapter):
# ZAI_CHAT_ID=""
# ZAI_USER_ID=""
# ZAI_TOKEN=""

# NEVER prefix provider keys with NEXT_PUBLIC_. The adapter is server-only.
# Providers are never auto-fallback. Each provider may incur costs; use only
# after checking pricing/free tier and explicitly authorizing its use.

# === Session (OPTIONAL) ===
# Session secret for cookie signing (if different from default)
# SESSION_SECRET="your-session-secret"

# === Site URL (REQUIRED for production, OPTIONAL in local dev) ===
# The canonical public URL of the deployment, without a trailing slash.
# All canonical URLs, sitemap entries, robots.txt Host directive,
# Open Graph URLs, and JSON-LD absolute URLs are derived from this
# value via src/lib/site-config.ts (single source of truth).
#
# Local dev:    unset → falls back to https://heavix.ir (safe default).
# Production:   MUST be set explicitly to the real public URL.
#               A console.warn is emitted at boot if unset in production.
NEXT_PUBLIC_SITE_URL="https://heavix.ir"

# === Deployment (OPTIONAL) ===
# Set NODE_ENV to "production" for production builds
NODE_ENV="development"
