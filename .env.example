# HEAVIX — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env with real values.

# === Database (REQUIRED) ===
# Main marketplace database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/heavix?schema=public"

# Store/parts database (PostgreSQL, separate instance)
STORE_DATABASE_URL="postgresql://user:password@localhost:5433/heavix_store?schema=public"

# === Admin (REQUIRED) ===
# Admin panel login credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-in-production"

# === AI Gateway (OPTIONAL) ===
# The AI Gateway uses z-ai-web-dev-sdk which may require an API key.
# If the SDK requires configuration, set it here.
# ZAI_API_KEY="your-api-key"

# === Session (OPTIONAL) ===
# Session secret for cookie signing (if different from default)
# SESSION_SECRET="your-session-secret"

# === Site URL (REQUIRED for production, OPTIONAL in local dev) ===
# The canonical public URL of the deployment, without a trailing slash.
# All canonical URLs, sitemap entries, robots.txt Host directive,
# Open Graph URLs, and JSON-LD absolute URLs are derived from this
# value via src/lib/site-config.ts (single source of truth).
#
# Local dev:    unset → falls back to https://heavix.ir (safe default).
# Production:   MUST be set explicitly to the real public URL.
#               A console.warn is emitted at boot if unset in production.
NEXT_PUBLIC_SITE_URL="https://heavix.ir"

# === Deployment (OPTIONAL) ===
# Set NODE_ENV to "production" for production builds
NODE_ENV="development"
