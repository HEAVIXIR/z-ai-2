-# HEAVIX — CI Pipeline (R16 GATE 09)
-# Runs on cloudflare-migration branch only.
-# Pipeline: install → lint → typecheck → test → build → vinext check
-# No deployment, no merge, no production.
-
-name: CI
-
-on:
-  push:
-    branches: [cloudflare-migration]
-  pull_request:
-    branches: [main]
-
-permissions:
-  contents: read
-
-jobs:
-  validate:
-    name: Install → Lint → Typecheck → Test → Build
-    runs-on: ubuntu-latest
-
-    steps:
-      - name: Checkout
-        uses: actions/checkout@v4
-
-      - name: Setup Bun
-        uses: oven-sh/setup-bun@v2
-        with:
-          bun-version: latest
-
-      - name: Install dependencies
-        run: bun install --frozen-lockfile
-
-      - name: Lint
-        run: bun run lint
-
-      - name: Typecheck
-        run: bunx tsc --noEmit
-
-      - name: Generate Prisma Client
-        run: bunx prisma generate --schema=prisma/schema.prisma
-
-      - name: Unit tests
-        run: bun test tests/unit/ tests/contract/ tests/security/ --timeout 30000
-        continue-on-error: true # Some tests require DB; will be fixed in migration
-
-      - name: Build
-        run: bun run build
-        env:
-          DATABASE_URL: "file:/tmp/test.db"
-          NODE_ENV: "production"
-
-  vinext-check:
-    name: vinext Compatibility Check
-    runs-on: ubuntu-latest
-    needs: validate
-    if: success()
-
-    steps:
-      - name: Checkout
-        uses: actions/checkout@v4
-
-      - name: Setup Node.js
-        uses: actions/setup-node@v4
-        with:
-          node-version: '20'
-
-      - name: Install
-        run: npm install
-
-      - name: vinext check
-        run: npx vinext check
-        continue-on-error: true # vinext is beta; document failures, don't block
-
-  # No deployment step.
-  # No merge step.
-  # No production step.
-  # CI must fail closed for main branch protection.
